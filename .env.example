# SentinelX frontend configuration — PLACEHOLDERS ONLY.
# Copy to `.env.local` for local use. Never commit real values.
# Anything prefixed with VITE_ is bundled into the browser build and is PUBLIC.
# Secrets (API keys, passwords, tokens) must live on a backend / secrets store, never here.

# Base URL of the future SentinelX backend API (leave empty to run in DEMO MODE).
VITE_API_BASE_URL=

# Optional label shown in the environment badge (e.g. DEMO, LAB, STAGING).
VITE_ENVIRONMENT_LABEL=DEMO ENVIRONMENT

# Backend-only variable names (documented here for reference; NOT read by the frontend):
# ACTIVEPIECES_BASE_URL=
# ACTIVEPIECES_WEBHOOK_SECRET=
# WAZUH_API_URL=
# WAZUH_API_USER=
# WAZUH_API_PASSWORD=

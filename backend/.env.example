# Copy to backend/.env locally. Never commit backend/.env.
APP_ENV=development
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://aiman0x.github.io
REQUEST_TIMEOUT_SECONDS=15

# Existing ActivePieces Windows telemetry receiver.
# Fill these on the backend host only after copying the webhook URL from ActivePieces.
AP_TELEMETRY_WEBHOOK_URL=
AP_TELEMETRY_HEADER_NAME=X-SentinelX-Key
AP_TELEMETRY_SECRET=

# Each URL must be a dedicated read-only ActivePieces webhook that queries the named
# existing table and returns {"data":[...]} or {"items":[...]}. Keep shared secret server-side.
AP_BRIDGE_HEADER_NAME=X-SentinelX-Bridge-Key
AP_BRIDGE_SECRET=
AP_ALERTS_READ_URL=
AP_CASES_READ_URL=
AP_ASSETS_READ_URL=
AP_RULES_READ_URL=
AP_INTEGRATIONS_READ_URL=
AP_AUDIT_READ_URL=
AP_INVESTIGATIONS_READ_URL=
AP_EVIDENCE_READ_URL=

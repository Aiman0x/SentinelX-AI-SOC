# SentinelX Cloudflare Worker API base URL
SENTINELX_API_URL=https://sentinelx-api-gateway.aiman132046.workers.dev
# Create a Linux collector in SentinelX > Host Collectors and paste its token here.
SENTINELX_COLLECTOR_TOKEN=

# Wazuh Manager API (keep loopback/internal where possible)
WAZUH_MANAGER_URL=https://127.0.0.1:55000
WAZUH_API_USER=
WAZUH_API_PASSWORD=

# Wazuh Indexer API (keep loopback/internal where possible)
WAZUH_INDEXER_URL=https://127.0.0.1:9200
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=

# Path to the Wazuh CA certificate if its certificate is not in the OS trust store.
# Never disable TLS verification. Leave empty only when the certificate chains to a trusted CA.
WAZUH_CA_BUNDLE=
WAZUH_LOOKBACK_MINUTES=5
WAZUH_BATCH_SIZE=200
